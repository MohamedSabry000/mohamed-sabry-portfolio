{
  "name": "mohamed-sabry-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "studio": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "studio:seed": "cd studio && npx sanity exec scripts/seed.ts --with-user-token",
    "build:pages": "VITE_BASE=/mohamed-sabry-portfolio/ VITE_STATIC=true VITE_SANITY_PROJECT_ID=rdln7m0z VITE_SANITY_DATASET=production vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^8.5.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
